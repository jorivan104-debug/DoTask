DATABASE_URL=postgresql://dotask:dotask@localhost:5432/dotask?schema=public
REDIS_URL=redis://localhost:6379
# Inicio de sesión con Google: Google Cloud Console → APIs y servicios → Credenciales →
# ID de cliente OAuth (tipo "Aplicación web"). URI de redireccionamiento autorizado = GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/callback
# Firma HMAC de las cookies (obligatoria, mínimo 32 caracteres). Generar con: openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-de-48-caracteres
# URL pública del API (emisor OAuth del conector MCP de Claude; el servidor MCP queda en $PUBLIC_API_URL/mcp)
PUBLIC_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
PORT=3000

# Login fijo solo en local (nunca en producción: NODE_ENV=production lo bloquea)
DOTASK_DEV_LOGIN=true
DOTASK_DEV_LOGIN_PASSWORD=dotask-dev
# Opcional: usuario creado/actualizado en BD
# DOTASK_DEV_LOGIN_EMAIL=dev@dotask.local
# DOTASK_DEV_LOGIN_NAME=Usuario local (dev)

# Notificaciones push (Web Push / VAPID) — recordatorios y tareas vencidas en celular y PC.
# Generar el par de claves una sola vez con: npx web-push generate-vapid-keys
# Sin estas claves la app funciona igual, pero sin notificaciones push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@app-sprint.com
# Pon "false" para no revisar recordatorios en esta instancia (p. ej. una réplica extra).
TASK_ALERTS_ENABLED=true

# Google Drive (opcional): selector de archivos para vincular documentos a las tareas.
# DoTask no guarda archivos, solo el enlace. En Google Cloud Console: habilitar "Google Picker API"
# y "Google Drive API", crear una clave de API restringida al dominio del front, y añadir el
# origen del front en "Orígenes de JavaScript autorizados" del ID de cliente OAuth.
# Sin estas variables se pueden vincular archivos pegando su enlace.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
