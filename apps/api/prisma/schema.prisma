generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Identificador estable de la cuenta de Google (`sub` del id_token). Nulo solo
  /// para cuentas aún no vinculadas (creadas antes del cambio) o el usuario de desarrollo.
  googleSub    String?  @unique @map("google_sub")
  email        String   @unique @db.Citext
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  memberships        WorkspaceMember[]
  createdSpaces      Workspace[]            @relation("WorkspaceCreator")
  assignedTasks      Task[]                 @relation("TaskAssignee")
  taskComments       TaskComment[]
  sentInvitations    WorkspaceInvitation[]  @relation("InvitationSender")
  myDayEntries       MyDayEntry[]
  pushSubscriptions  PushSubscription[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  creator     User                  @relation("WorkspaceCreator", fields: [createdBy], references: [id])
  members     WorkspaceMember[]
  projects    Project[]
  invitations WorkspaceInvitation[]
  categories  Category[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("member")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskLists TaskList[]
  links     ProjectLink[]

  @@index([workspaceId, sortOrder])
  @@map("projects")
}

model ProjectLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  label     String
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_links")
}

model TaskList {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, sortOrder])
  @@map("task_lists")
}

/// Tarea con los campos de Microsoft To Do (todoTask de Microsoft Graph).
model Task {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId         String    @map("list_id") @db.Uuid
  title          String
  notes          String?
  notesUpdatedAt DateTime? @map("notes_updated_at") @db.Timestamptz()
  /// not_started | in_progress | waiting_on_others | deferred | completed
  status         String    @default("not_started")
  /// low | normal | high (high = estrella "Importante")
  importance     String    @default("normal")
  startAt        DateTime? @map("start_at") @db.Timestamptz()
  dueAt          DateTime? @map("due_at") @db.Timestamptz()
  remindAt       DateTime? @map("remind_at") @db.Timestamptz()
  /// Zona horaria IANA con la que se calculan las repeticiones (p. ej. America/Bogota).
  timezone       String?
  /// Patrón de repetición: { pattern: { type, interval, daysOfWeek? }, range: { type, endDate?, numberOfOccurrences? } }
  recurrence     Json?
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()
  assigneeId     String?   @map("assignee_id") @db.Uuid
  sortOrder      Int       @default(0) @map("sort_order")
  /// Quién hizo el último cambio relevante: user | claude
  source         String    @default("user")
  /// Cuándo se envió la notificación push del recordatorio (se limpia si cambia `remindAt`).
  reminderSentAt    DateTime? @map("reminder_sent_at") @db.Timestamptz()
  /// Cuándo se avisó que la tarea venció (se limpia si cambia `dueAt`).
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  list            TaskList             @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee        User?                @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments        TaskComment[]
  myDayEntries    MyDayEntry[]
  steps           TaskStep[]
  categories      TaskCategory[]
  linkedResources TaskLinkedResource[]

  @@index([listId, sortOrder])
  @@index([assigneeId])
  @@index([dueAt])
  @@index([remindAt])
  @@map("tasks")
}

/// Paso de una tarea (checklistItem de To Do).
model TaskStep {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  title     String
  isChecked Boolean   @default(false) @map("is_checked")
  checkedAt DateTime? @map("checked_at") @db.Timestamptz()
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@map("task_steps")
}

/// Categoría (etiqueta de color) compartida por el espacio de trabajo.
model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  color       String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskCategory[]

  @@unique([workspaceId, name])
  @@map("categories")
}

model TaskCategory {
  taskId     String @map("task_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([taskId, categoryId])
  @@index([categoryId])
  @@map("task_categories")
}

/// Recurso vinculado (linkedResource de To Do): un archivo de Google Drive, un chat de Claude, un enlace.
/// DoTask no almacena archivos: solo guarda el enlace.
model TaskLinkedResource {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  /// "Google Drive", "Claude", "Web"…
  applicationName String   @map("application_name")
  displayName     String   @map("display_name")
  externalId      String?  @map("external_id")
  webUrl          String?  @map("web_url")
  /// Tipo MIME (archivos de Drive), para mostrar el ícono adecuado.
  mimeType        String?  @map("mime_type")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([applicationName, webUrl])
  @@map("task_linked_resources")
}

model WorkspaceInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  role            String    @default("member")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz()
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedByUserId], references: [id])

  @@index([workspaceId])
  @@map("workspace_invitations")
}

model TaskComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// "Mi día" es personal: cada usuario elige qué tareas trabaja hoy (como en Microsoft To Do).
/// Una entrada por usuario y tarea; `day` es la fecha local del usuario. La lista se
/// "reinicia" sola porque solo se muestran las entradas cuyo `day` es hoy.
model MyDayEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, day])
  @@map("my_day_entries")
}

/// Suscripción Web Push (VAPID) de un navegador o celular del usuario.
model PushSubscription {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
